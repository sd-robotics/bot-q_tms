<?xml version="1.0" encoding="UTF-8" ?>
<robot name="base" xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:macro name="base" params="parent prefix *origin">

    <!-- Base -->
    <joint name="${prefix}_body_joint" type="fixed">
      <parent link="${parent}" />
      <child link="${prefix}_body_link" />
      <xacro:insert_block name="origin" />
    </joint>

    <link name="${prefix}_body_link">
      <visual>
        <origin xyz="0.0 0.0 0.0" rpy="0 0 ${M_PI/2}" />
        <geometry>
          <mesh filename="file://$(find bot_q_tms_description)/meshes/base/tms_body.stl" scale="0.001 0.001 0.001" />
        </geometry>
        <material name="body" />
      </visual>

      <collision>
        <origin xyz="0.0 0.0 0.0" rpy="0 0 ${M_PI/2}" />
        <geometry>
          <mesh filename="file://$(find bot_q_tms_description)/meshes/base/tms_body.stl" scale="0.001 0.001 0.001" />
        </geometry>
      </collision>

      <!-- TODO -->
      <inertial>
        <mass value="6.4" />
        <origin xyz="0 0 0" rpy="0 0 0" />
        <inertia ixx="2.1342e-02" ixy="0" ixz="0"
                 iyy="2.1342e-02" iyz="0"
                 izz="4.2667e-02" />
      </inertial>
    </link>

    <!-- Joint 1: Spool -->
    <joint name="${prefix}_spool_joint" type="continuous">
      <parent link="${prefix}_body_link" />
      <child link="${prefix}_spool_link" />
      <origin xyz="-0.246 -0.1156 0.0338" rpy="0 0 0" />
      <limit effort="10" velocity="1" />
      <axis xyz="0 1 0" />
    </joint>

    <link name="${prefix}_spool_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 ${M_PI}" />
        <geometry>
          <mesh filename="file://$(find bot_q_tms_description)/meshes/base/tms_spool.stl" scale="0.001 0.001 0.001" />
        </geometry>
        <material name="body" />
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="0 0 ${M_PI}" />
        <geometry>
          <mesh filename="file://$(find bot_q_tms_description)/meshes/base/tms_spool.stl" scale="0.001 0.001 0.001" />
          <!-- <cylinder length="0.1" radius="0.05" /> -->
        </geometry>
      </collision>

      <inertial>
        <mass value="0.5" />
        <origin xyz="0 0 0" rpy="0 0 0" />
        <inertia ixx="${1/12*0.5*(3*0.05**2+0.1**2)}" ixy="0" ixz="0"
                 iyy="${1/12*0.5*(3*0.05**2+0.1**2)}" iyz="0"
                 izz="${1/2*0.5*0.05**2}" />
      </inertial>
    </link>

    <!-- Joint 2: Guider -->
    <joint name="${prefix}_guider_joint" type="continuous">
      <parent link="${prefix}_body_link" />
      <child link="${prefix}_guider_link" />
      <origin xyz="-0.166 -0.1156 0.035" rpy="0 0 0" />
      <limit effort="10" velocity="1" />
      <axis xyz="0 1 0" />
    </joint>

    <link name="${prefix}_guider_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 ${M_PI}" />
        <geometry>
          <mesh filename="file://$(find bot_q_tms_description)/meshes/base/tms_guider.stl" scale="0.001 0.001 0.001" />
        </geometry>
        <material name="body" />
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="0 0 ${M_PI}" />
        <geometry>
          <mesh filename="file://$(find bot_q_tms_description)/meshes/base/tms_guider.stl" scale="0.001 0.001 0.001" />
          <!-- <cylinder length="0.1" radius="0.05" /> -->
        </geometry>
      </collision>

      <inertial>
        <mass value="0.5" />
        <origin xyz="0 0 0" rpy="0 0 0" />
        <inertia ixx="${1/12*0.5*(3*0.05**2+0.1**2)}" ixy="0" ixz="0"
                 iyy="${1/12*0.5*(3*0.05**2+0.1**2)}" iyz="0"
                 izz="${1/2*0.5*0.05**2}" />
      </inertial>
    </link>

  </xacro:macro>
</robot>
