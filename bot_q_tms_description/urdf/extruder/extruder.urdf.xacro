<?xml version="1.0" encoding="UTF-8" ?>
<robot name="extruder" xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:macro name="extruder" params="parent prefix">

    <!-- extruder -->
    <joint name="${prefix}_body_joint" type="fixed">
      <parent link="${parent}" />
      <child link="${prefix}_body_link" />
      <origin xyz="-0.166 -${0.1156-0.1136} 0.035" rpy="0 -${M_PI/2} 0" />
    </joint>

    <link name="${prefix}_body_link">
      <visual>
        <origin xyz="0.0 0.0 0.0" rpy="0 0 ${M_PI/2}" />
        <geometry>
          <mesh filename="file://$(find bot_q_tms_description)/meshes/extruder/extruder_body.stl" scale="0.001 0.001 0.001" />
        </geometry>
        <material name="body" />
      </visual>

      <!-- TODO -->
      <collision>
        <origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
        <geometry>
          <mesh filename="file://$(find bot_q_tms_description)/meshes/extruder/extruder_body.stl" scale="0.001 0.001 0.001" />
        </geometry>
      </collision>

      <!-- TODO -->
      <inertial>
        <mass value="6.4" />
        <origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
        <inertia ixx="2.1342e-02" ixy="0" ixz="0"
                 iyy="2.1342e-02" iyz="0"
                 izz="4.2667e-02" />
      </inertial>
    </link>

    <!-- Joint 3: Extruder Gear -->
    <joint name="${prefix}_gear_joint" type="continuous">
      <parent link="${prefix}_body_link" />
      <child link="${prefix}_gear_link" />
      <origin xyz="-0.082 -0.0108 -0.02525" rpy="0 0 0" />
      <limit effort="10" velocity="1" />
      <axis xyz="1 0 0" />
    </joint>

    <link name="${prefix}_gear_link">
      <visual>
        <origin xyz="0.0 0.0 0.0" rpy="0 0 ${M_PI/2}" />
        <geometry>
          <mesh filename="file://$(find bot_q_tms_description)/meshes/extruder/extruder_gear.stl" scale="0.001 0.001 0.001" />
          <!-- <cylinder length="0.1" radius="0.05" /> -->
        </geometry>
        <material name="body" />
      </visual>

      <!-- TODO -->
      <collision>
        <origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
        <geometry>
          <mesh filename="file://$(find bot_q_tms_description)/meshes/extruder/extruder_gear.stl" scale="0.001 0.001 0.001" />
          <!-- <cylinder length="0.1" radius="0.05" /> -->
        </geometry>
      </collision>

      <!-- TODO -->
      <inertial>
        <mass value="0.5" />
        <origin xyz="0 0 0" rpy="0 0 0" />
        <inertia ixx="${1/12*0.5*(3*0.05**2+0.1**2)}" ixy="0" ixz="0"
                 iyy="${1/12*0.5*(3*0.05**2+0.1**2)}" iyz="0"
                 izz="${1/2*0.5*0.05**2}" />
      </inertial>
    </link>

    <!-- Joint 3-1: Extruder Gear Sub -->
    <joint name="${prefix}_gear_sub_joint" type="continuous">
      <parent link="${prefix}_body_link" />
      <child link="${prefix}_gear_sub_link" />
      <origin xyz="-0.084 0.01394608 -0.02525" rpy="0 0 0" />
      <mimic joint="${prefix}_gear_joint" />
      <limit effort="10" velocity="1" /> 
      <axis xyz="-1 0 0" />
    </joint>

    <link name="${prefix}_gear_sub_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 ${M_PI/2}" />
        <geometry>
          <mesh filename="file://$(find bot_q_tms_description)/meshes/extruder/extruder_gear_sub.stl" scale="0.001 0.001 0.001" />
          <!-- <cylinder length="0.1" radius="0.05" /> -->
        </geometry>
        <material name="body" />
      </visual>

      <!-- TODO -->
      <collision>
        <origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
        <geometry>
          <mesh filename="file://$(find bot_q_tms_description)/meshes/extruder/extruder_gear_sub.stl" scale="0.001 0.001 0.001" />
          <!-- <cylinder length="0.1" radius="0.05" /> -->
        </geometry>
      </collision>

      <!-- TODO -->
      <inertial>
        <mass value="0.5" />
        <origin xyz="0 0 0" rpy="0 0 0" />
        <inertia ixx="${1/12*0.5*(3*0.05**2+0.1**2)}" ixy="0" ixz="0"
                 iyy="${1/12*0.5*(3*0.05**2+0.1**2)}" iyz="0"
                 izz="${1/2*0.5*0.05**2}" />
      </inertial>
    </link>

  </xacro:macro>
</robot>
