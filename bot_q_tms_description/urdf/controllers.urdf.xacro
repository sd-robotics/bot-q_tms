<?xml version="1.0" encoding="UTF-8" ?>
<!-- Bot-Q TMS (Dynamixel Control) -->
<robot name="bot_q_tms_controllers" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="controllers" params="name enable_gz:=False robot_name:=bot_q_tms">

    <ros2_control name="${name}" type="system">
      <hardware>
        <xacro:if value="${$(arg enable_gz)}">
          <plugin>ign_ros2_control/IgnitionSystem</plugin>
          <!-- <plugin>gz_ros2_control/GazeboSimSystem</plugin> -->
        </xacro:if>
        <xacro:unless value="${$(arg enable_gz)}">
          <plugin>dynamixel_hardware/DynamixelHardware</plugin>
          <param name="port_name">/dev/ttyUSB0</param>
          <param name="baud_rate">1000000</param>
        </xacro:unless>
      </hardware>

      <!-- Velocity Drive -->
      <joint name="base_spool_joint">
        <xacro:unless value="${$(arg enable_gz)}">
          <param name="id">1</param>
          <param name="control_mode">1</param>
          <param name="interface">rs</param>
        </xacro:unless>
        <command_interface name="velocity"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>

      <joint name="base_guider_joint">
        <xacro:unless value="${$(arg enable_gz)}">
          <param name="id">2</param>
          <param name="control_mode">1</param>
          <param name="interface">rs</param>
        </xacro:unless>
        <command_interface name="velocity"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>

      <joint name="extruder_gear_joint">
        <xacro:unless value="${$(arg enable_gz)}">
          <param name="id">3</param>
          <param name="control_mode">1</param>
          <param name="interface">rs</param>
        </xacro:unless>
        <command_interface name="velocity"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>

      <xacro:if value="${$(arg enable_gz)}">
        <joint name="extruder_gear_sub_joint">
          <param name="mimic">extruder_gear_joint</param>
          <param name="multiplier">-1</param>
          <command_interface name="velocity"/>
          <state_interface name="velocity"/>
          <state_interface name="effort"/>
        </joint>
      </xacro:if>
    
    </ros2_control>


    <!-- Ignition ROS2 Control -->
    <xacro:if value="${$(arg enable_gz)}">
      <gazebo>
        <plugin filename="ign_ros2_control-system" name="ign_ros2_control::IgnitionROS2ControlPlugin">
        <!-- <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin"> -->
          <ros>
            <namespace>${robot_name}</namespace>
          </ros>
          <parameters>$(find bot_q_tms_control)/config/gz_controllers.yaml</parameters>
        </plugin>
      </gazebo>
    </xacro:if>

  </xacro:macro>

</robot>
